{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$j = [Console]::In.ReadToEnd() | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -and ($f -match '\\.py$') -and (Test-Path $f)) { & \"$env:CLAUDE_PROJECT_DIR\\venv\\Scripts\\python.exe\" -m black $f; exit 0 }",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
